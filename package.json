{
  "name": "staked-vault",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "$STAKED dual-reward staking vault + fee distributor on Base",
  "scripts": {
    "compile": "node scripts/compile.mjs",
    "test": "node scripts/compile.mjs && node test/vault.test.mjs",
    "build:web": "node scripts/build-web.mjs",
    "test:web": "npm run build:web && node --test test/web-safety.test.mjs test/web-browser.test.mjs",
    "test:bnkr": "npm run compile && node test/bnkr-staking.test.mjs",
    "test:bnkr:fork": "node scripts/fork/run.mjs --bnkr-staking"
  },
  "devDependencies": {
    "@ethereumjs/block": "5.3.0",
    "@ethereumjs/common": "4.4.0",
    "@ethereumjs/util": "9.1.0",
    "@ethereumjs/vm": "8.1.1",
    "@playwright/test": "1.58.2",
    "esbuild": "0.28.2",
    "solc": "0.8.24",
    "viem": "2.21.0"
  },
  "dependencies": {
    "@walletconnect/ethereum-provider": "2.25.0",
    "ethers": "5.8.0",
    "qrcode": "1.5.4"
  },
  "overrides": {
    "ws": "8.21.0",
    "tmp": "0.2.7"
  }
}
